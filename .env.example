DATABASE_URL=postgresql://user:password@localhost:5432/rangkul_cerita
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECTION_TIMEOUT_MS=10000
GEMINI_API_KEY=
AI_PROVIDER_TIMEOUT_MS=30000

# Server-enforced rate limits (per client, fixed window)
RATE_LIMIT_REFLECT_MAX=5
RATE_LIMIT_REFLECT_WINDOW_SECONDS=60
RATE_LIMIT_NEWSLETTER_MAX=5
RATE_LIMIT_NEWSLETTER_WINDOW_SECONDS=3600
RATE_LIMIT_UNSUBSCRIBE_MAX=10
RATE_LIMIT_UNSUBSCRIBE_WINDOW_SECONDS=3600
RATE_LIMIT_PARTNERSHIP_MAX=3
RATE_LIMIT_PARTNERSHIP_WINDOW_SECONDS=3600

# Distributed rate limiting (production on Vercel via Upstash Redis REST)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
